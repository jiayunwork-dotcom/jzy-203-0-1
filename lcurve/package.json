{
  "name": "lcurve-service",
  "version": "1.0.0",
  "private": true,
  "description": "Learning-curve fitting and forecasting service for part manufacturing (event-sourced, Express + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:db": "jest --selectProjects db"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "16.6.0-beta.15",
    "@embedded-postgres/darwin-x64": "16.6.0-beta.15",
    "@embedded-postgres/linux-arm64": "16.6.0-beta.15",
    "@embedded-postgres/linux-x64": "16.6.0-beta.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
