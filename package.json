{
  "name": "learning-curve-service",
  "version": "1.0.0",
  "private": true,
  "description": "学习曲线成本估算后端：批次事件溯源 + 单件工时学习曲线拟合与预测",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand",
    "test:integration": "REQUIRE_DB=1 jest --runInBand test/api.integration.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "16.14.0-beta.17",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
